# IMAP account. The password is NOT here: it is supplied through
# IMAP_PASSWORD_FILE=/run/secrets/imap_password (see docker-compose.yml).
IMAP_HOST=imap.franklymail.com
IMAP_USER=you@example.com

# Optional: limit folders. Default is every selectable folder except
# Junk/Trash/All Mail. Set IMAP_ALL_FOLDERS=true to include those too.
# IMAP_FOLDERS=INBOX,Sent Items
# IMAP_ALL_FOLDERS=false

# S3 destination.
S3_BUCKET=my-mail-archive
S3_PREFIX=mail
AWS_REGION=us-east-1
# Uncomment these to use static keys.  If the container runs with an IAM role
# or a mounted AWS profile, leave them commented out.
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Optional S3 settings.
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# S3_STORAGE_CLASS=STANDARD_IA
# S3_SSE=aws:kms
# S3_KMS_KEY_ID=

# How often to fetch and upload (seconds).
INTERVAL_SECONDS=300

# Cap each numbered JSONL file at this many records (the reset baseline plus
# add/rm operations).  Must be at least 2.
MAX_OPS_PER_FILE=5000

# Close the active file and start a new reset baseline this often (seconds).
SNAPSHOT_EVERY_SECONDS=604800

LOG_LEVEL=INFO
